<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="GraphiteWindowColor">#1C1C1E</Color>
    <Color x:Key="GraphiteEditorColor">#242426</Color>
    <Color x:Key="GraphiteToolbarColor">#2C2C2E</Color>
    <Color x:Key="GraphiteBorderColor">#3A3A3C</Color>
    <Color x:Key="GraphitePrimaryTextColor">#F5F5F7</Color>
    <Color x:Key="GraphiteSecondaryTextColor">#A1A1A6</Color>
    <Color x:Key="GraphiteAccentColor">#0A84FF</Color>
    <Color x:Key="GraphiteDangerColor">#FF453A</Color>

    <SolidColorBrush x:Key="GraphiteWindowBrush" Color="{DynamicResource GraphiteWindowColor}" />
    <SolidColorBrush x:Key="GraphiteEditorBrush" Color="{DynamicResource GraphiteEditorColor}" />
    <SolidColorBrush x:Key="GraphiteToolbarBrush" Color="{DynamicResource GraphiteToolbarColor}" />
    <SolidColorBrush x:Key="GraphiteBorderBrush" Color="{DynamicResource GraphiteBorderColor}" />
    <SolidColorBrush x:Key="GraphitePrimaryTextBrush" Color="{DynamicResource GraphitePrimaryTextColor}" />
    <SolidColorBrush x:Key="GraphiteSecondaryTextBrush" Color="{DynamicResource GraphiteSecondaryTextColor}" />
    <SolidColorBrush x:Key="GraphiteAccentBrush" Color="{DynamicResource GraphiteAccentColor}" />
    <SolidColorBrush x:Key="GraphiteDangerBrush" Color="{DynamicResource GraphiteDangerColor}" />
    <SolidColorBrush x:Key="GraphiteTransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="GraphiteSelectionBrush" Color="#660A84FF" />
    <SolidColorBrush x:Key="GraphitePressedBrush" Color="#46464A" />

    <FontFamily x:Key="GraphiteFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <CornerRadius x:Key="GraphiteShellCornerRadius">14</CornerRadius>
    <CornerRadius x:Key="GraphiteControlCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="GraphiteTaskCornerRadius">10</CornerRadius>

    <Style x:Key="GraphiteFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="1"
                            BorderBrush="{DynamicResource GraphiteAccentBrush}"
                            BorderThickness="2"
                            CornerRadius="8">
                        <AdornedElementPlaceholder />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="GraphiteButtonTemplate" TargetType="{x:Type Button}">
        <Border x:Name="ButtonChrome"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{DynamicResource GraphiteControlCornerRadius}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ButtonChrome"
                        Property="Background"
                        Value="{DynamicResource GraphiteBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="ButtonChrome"
                        Property="Background"
                        Value="{DynamicResource GraphitePressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonChrome" Property="Opacity" Value="0.86" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="GraphiteToolbarButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource GraphiteTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GraphiteBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GraphiteFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{DynamicResource GraphiteFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource GraphitePrimaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Template" Value="{StaticResource GraphiteButtonTemplate}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="GraphiteTitleButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource GraphiteTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GraphiteFocusVisualStyle}" />
        <Setter Property="FontFamily" Value="{DynamicResource GraphiteFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource GraphiteSecondaryTextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="Template" Value="{StaticResource GraphiteButtonTemplate}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="GraphiteDateHeaderButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource GraphiteTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GraphiteTransparentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GraphiteFocusVisualStyle}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Template" Value="{StaticResource GraphiteButtonTemplate}" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="Arrow" />
                <Setter Property="Opacity" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GraphiteTaskCheckBoxStyle" TargetType="{x:Type CheckBox}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource GraphiteFocusVisualStyle}" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Width" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <Border x:Name="CheckSurface"
                            Background="{DynamicResource GraphiteEditorBrush}"
                            BorderBrush="{DynamicResource GraphiteSecondaryTextBrush}"
                            BorderThickness="1"
                            CornerRadius="5">
                        <TextBlock x:Name="CheckMark"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{DynamicResource GraphiteFontFamily}"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Text="✓"
                                   Visibility="Collapsed" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckSurface"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GraphiteAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckSurface"
                                    Property="Background"
                                    Value="{DynamicResource GraphiteAccentBrush}" />
                            <Setter TargetName="CheckSurface"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GraphiteAccentBrush}" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="CheckSurface" Property="BorderThickness" Value="2" />
                            <Setter TargetName="CheckSurface"
                                    Property="BorderBrush"
                                    Value="{DynamicResource GraphiteAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="CheckSurface" Property="Opacity" Value="0.58" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GraphiteScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="{DynamicResource GraphiteTransparentBrush}" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}"
                                              Focusable="False"
                                              Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                            <Border x:Name="ThumbSurface"
                                                    Margin="2,1"
                                                    Background="{DynamicResource GraphiteBorderBrush}"
                                                    CornerRadius="3" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbSurface"
                                                            Property="Background"
                                                            Value="{DynamicResource GraphiteSecondaryTextBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}"
                                              Focusable="False"
                                              Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource GraphiteScrollBarStyle}" />
</ResourceDictionary>
