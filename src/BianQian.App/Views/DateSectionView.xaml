<UserControl x:Class="BianQian.App.Views.DateSectionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BianQian.App.Views"
             xmlns:viewModels="clr-namespace:BianQian.App.ViewModels"
             Background="Transparent"
             FontFamily="{DynamicResource GraphiteFontFamily}"
             Foreground="{DynamicResource GraphitePrimaryTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
        <DataTemplate DataType="{x:Type viewModels:TextBlockViewModel}">
            <views:TextBlockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:TaskBlockViewModel}">
            <views:TaskBlockView />
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,18">
        <Button AutomationProperties.Name="{Binding Date, StringFormat=便签日期 {0:yyyy-MM-dd}}"
                Command="{Binding DataContext.ToggleDateSectionCommand, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                CommandParameter="{Binding}"
                IsEnabled="{Binding CanToggle}"
                Style="{DynamicResource GraphiteDateHeaderButtonStyle}">
            <TextBlock x:Name="DateHeaderText"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GraphiteSecondaryTextBrush}"
                       Text="{Binding Date, StringFormat={}{0:yyyy-MM-dd}}" />
        </Button>
        <ItemsControl Margin="2,4,2,0"
                      ItemsSource="{Binding Blocks}"
                      Visibility="{Binding IsExpanded, Converter={StaticResource BooleanToVisibility}}" />
    </StackPanel>
</UserControl>
